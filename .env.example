# Quran Companion AI — Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# ----------------------------------------------------
# 1. Server Configuration
# ----------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENV=production

# ----------------------------------------------------
# 2. Database Connection
# ----------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./quran_companion.db

# Production Free-Tier PostgreSQL (e.g. Neon serverless):
# Format: postgresql+asyncpg://<username>:<password>@<ep-xyz>.neon.tech/<dbname>?sslmode=require
# Or standard postgresql:// (automatically converted to asyncpg at runtime):
# DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-cold-star-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Connection Pooling (for PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_SSL_REQUIRE=true

# ----------------------------------------------------
# 3. Security & Authentication
# ----------------------------------------------------
# Generate a strong 32-byte secret in production using: openssl rand -hex 32
JWT_SECRET=super-secret-quran-companion-dev-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated, or * for open access)
CORS_ORIGINS=*

# ----------------------------------------------------
# 4. Speech Recognition & AI Inference
# ----------------------------------------------------
WHISPER_MODEL_ID=tarteel-ai/whisper-base-ar-quran
# Set USE_MOCK_ASR=true for low-memory CPU environments (< 1GB RAM) or offline tests
USE_MOCK_ASR=false

# ----------------------------------------------------
# 5. Privacy & Data Policies
# ----------------------------------------------------
# Quran audio is transient in RAM and purged after alignment by default
DEFAULT_AUDIO_RETENTION=false
