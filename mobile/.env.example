# Mobile Expo Environment Configuration
# For local Web or Android emulator:
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws/recitation

# For physical device testing over same Wi-Fi, change localhost to your PC's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api/v1
# EXPO_PUBLIC_WS_URL=ws://192.168.1.50:8000/ws/recitation

# For Live Production Cloud:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# EXPO_PUBLIC_WS_URL=wss://api.yourdomain.com/ws/recitation
